@article{gogus_postcollisional_2016,
	title = {Postcollisional lithospheric evolution of the Southeast Carpathians: Comparison of geodynamical models and observations},
	volume = {35},
	rights = {http://onlinelibrary.wiley.com/{termsAndConditions}\#am},
	issn = {0278-7407, 1944-9194},
	url = {https://agupubs.onlinelibrary.wiley.com/doi/10.1002/2015TC004096},
	doi = {10.1002/2015TC004096},
	shorttitle = {Postcollisional lithospheric evolution of the Southeast Carpathians},
	abstract = {Seismic evidence and thermal and topographic transients have led to the interpretation of lithospheric removal beneath the Southeast Carpathians region. A series of numerical geodynamic experiments in the context of the tectonic evolution of the region are conducted to test the surface-crustal response to lithosphere delamination and slab break-off. The results show that a delamination-type removal (“plate-like” migrating instability) causes a characteristic pattern of surface uplift/subsidence and crustal extension/shortening to occur due to the lithospheric deformation and dynamic/thermal forcing of the sublithospheric mantle. These features migrate with the progressive removal of the underlying lithosphere. Model results for delamination are comparable with observables related to the geodynamic evolution of the Southeast Carpathians since 10 Ma: the mantle structure inferred by seismic tomography, migrating patterns of uplift ({\textgreater}1.5 km) and subsidence ({\textgreater}2 km) in the region, crustal thinning in the Carpathian hinterland and thickening at the Focsani depression, and regional extension in the Carpathian corner (e.g., opening of Brasov basin) correlating with volcanism (e.g., Harghita and Persani volcanics) in the last 3 Myr.},
	pages = {1205--1224},
	number = {5},
	journaltitle = {Tectonics},
	shortjournal = {Tectonics},
	author = {Göğüş, Oğuz H. and Pysklywec, Russell N. and Faccenna, Claudio},
	urldate = {2026-07-22},
	date = {2016-05},
	langid = {english},
	file = {PDF:/home/ryanto/Zotero/storage/B7GWGF3K/Göğüş et al. - 2016 - Postcollisional lithospheric evolution of the Southeast Carpathians Comparison of geodynamical mode.pdf:application/pdf},
}

@article{zhang_geophysicalpetrological_2022,
