	file = {PDF:/home/ryanto/Zotero/storage/CZU2PNAV/van Laaten et al. - 2021 - Comparison of Multiple Lapse Time Window Analysis and Qopen to determine intrinsic and scattering at.pdf:application/pdf},
}

